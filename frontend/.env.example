# Optional local frontend overrides. Unset, the app talks to port 8000 on the
# same host the page was opened from. If you set these, use the SAME hostname
# you browse with (localhost vs 127.0.0.1 are different sites): the session
# cookie is only sent when the page and the API share a site.
# VITE_API_BASE_URL=http://localhost:8000
# VITE_WS_BASE_URL=ws://localhost:8000

# Only needed if the backend has API_KEY set in the root .env. Must match it.
# WARNING: every VITE_* value is inlined into the public JS bundle. This is a
# local shared secret, not a model provider key — never put an OpenAI/Gemini
# key in a VITE_* variable.
# VITE_API_KEY=
