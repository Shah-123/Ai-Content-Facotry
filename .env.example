OPENAI_API_KEY=sk-proj-your-openai-key-here
GOOGLE_API_KEY=AIzaSy-your-google-api-key-here
TAVILY_API_KEY=tvly-your-tavily-key-here
PEXELS_API_KEY=your-pexels-api-key-here

# Database Configuration (PostgreSQL when using Docker / Postgres, leave empty for SQLite)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_content_factory

# API access control (both optional; unset = open, which is fine on localhost only)
# API_KEY: when set, callers must send it as the X-API-Key header. The frontend
#          reads the same value from VITE_API_KEY (see frontend/.env.example).
# API_KEY=choose-a-long-random-string
# ALLOWED_ORIGINS: comma-separated CORS allowlist. Defaults to the local Vite
#                  dev server origins. Use "*" only for a throwaway demo.
# ALLOWED_ORIGINS=http://localhost:3000

# Optional
# HF_TOKEN=hf_your-huggingface-token-here
# FIRECRAWL_API_KEY=fc-your-firecrawl-key-here
# TWITTER_API_KEY=your-twitter-api-key-here
